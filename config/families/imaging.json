{
  "family": "imaging",
  "display_name": "Aspose.Imaging for .NET",
  "auto_commit": true,
  "commit_message_template": "fix(imaging): apply {patch_count} patches\n\n{file_list}\n\nSnippets: {snippet_ids}",
  "content_roots": [
    "${ASPOSE_CONTENT_ROOT}/blog.aspose.net/imaging",
    "${ASPOSE_CONTENT_ROOT}/docs.aspose.net/imaging/en",
    "${ASPOSE_CONTENT_ROOT}/kb.aspose.net/imaging/en"
  ],
  "content_pattern": {
    "blog": "**/index.md",
    "docs": "**/*.md",
    "kb": "**/*.md"
  },
  "file_exclude_patterns": [
    "index\\.[a-z]{2}\\.md$",
    "index\\.[a-z]{2}-[a-z]{2}\\.md$",
    "[/\\\\](ar|bg|ca|cs|da|de|el|es|fa|fi|fr|he|hi|hr|hu|id|it|ja|ko|lt|lv|ms|nl|no|pl|pt|ro|ru|sk|sr|sv|th|tr|uk|vi|zh)[/\\\\]"
  ],
  "nuget_config": {
    "primary_package": {
      "name": "Aspose.Imaging",
      "version_strategy": "latest_stable",
      "version": "26.8.0",
      "dll_name": "Aspose.Imaging"
    },
    "additional_packages": [],
    "target_frameworks": [
      "net8.0"
    ]
  },
  "code_defaults": {
    "default_usings": [
      "System",
      "System.IO",
      "System.Text",
      "Aspose.Imaging",
      "Aspose.Imaging.FileFormats",
      "Aspose.Imaging.FileFormats.Png",
      "Aspose.Imaging.FileFormats.Jpeg",
      "Aspose.Imaging.FileFormats.Bmp",
      "Aspose.Imaging.FileFormats.Gif",
      "Aspose.Imaging.FileFormats.Tiff",
      "Aspose.Imaging.ImageOptions",
      "Aspose.Imaging.ImageFilters.FilterOptions",
      "Aspose.Imaging.Brushes",
      "Aspose.Imaging.Sources"
    ]
  },
  "namespace_policy": {
    "mode": "whitelist",
    "allowed_namespaces": [
      "Aspose.Imaging",
      "Aspose.Imaging.*",
      "System",
      "System.*",
      "System.IO",
      "System.Text",
      "System.Drawing",
      "System.Collections.Generic",
      "System.Linq"
    ],
    "blacklist": []
  },
  "api_patterns": {},
  "runtime_validation": {
    "enabled": true,
    "mode": "lenient",
    "timeout_seconds": 30,
    "required_files": [
      "sample.png",
      "sample.jpg",
      "sample.bmp",
      "sample.gif",
      "sample.tiff"
    ],
    "required_dirs": [],
    "file_aliases": {
      "sample.png": [
        "PNG/aspose_logo.png",
        "PNG/template.png"
      ],
      "sample.jpg": [
        "JPEG/aspose-logo.jpg",
        "JPEG/test.jpg"
      ],
      "sample.bmp": [
        "Bmp/Rle4.bmp",
        "PNG/template.bmp"
      ],
      "sample.gif": [
        "GIF/ezgif.com-gif-maker(1)___.gif"
      ],
      "sample.tiff": [
        "Tiff/Sample.tif",
        "Tiff/lichee.tif"
      ]
    },
    "expected_outputs": [],
    "env": {}
  },
  "test_data": {
    "local_path": "artifacts/backfill/imaging/test-data",
    "download_if_missing": true,
    "inventory_path": "artifacts/backfill/imaging/test-data-inventory.json"
  },
  "gist": {
    "enabled": true,
    "pat_env_var": "GITHUB_PAT"
  },
  "discovery_patterns": {
    "fence_patterns": [
      "^```(\\w+|c#)\\s*\\n(.*?)^```"
    ],
    "validatable_languages": [
      "cs",
      "csharp",
      "c#",
      "C#"
    ],
    "normalize_to_canonical": true,
    "regex_timeout_seconds": 5.0,
    "context_extraction": {
      "enabled": true,
      "max_paragraphs": 3,
      "include_file_header": true
    },
    "gist_extraction": {
      "enabled": true,
      "allowed_owners": [
        "aspose-com-gists",
        "aspose-imaging"
      ],
      "blocked_owners": []
    }
  },
  "context_enforcement": {
    "enabled": true
  },
  "fixture_passwords": {
    "default": "p@s$"
  },
  "api_catalog": {
    "enabled": true,
    "storage_type": "json",
    "path": "config/families/imaging_api_catalog.json",
    "lazy_loading": false
  },
  "fixture_resolver": {
    "enabled": true,
    "max_generations_per_run": 50,
    "registry_path": "artifacts/backfill/imaging/fixture-registry.json"
  },
  "learned_patterns": {
    "enabled": true,
    "min_confidence": 0.6,
    "max_patterns_per_error": 3,
    "require_approval": true,
    "feedback_tracking": true,
    "retire_threshold": 0.3,
    "retire_min_applications": 10
  },
  "persistent_fix": {
    "enabled": true,
    "max_iterations": 10,
    "iterations_per_model": 3,
    "max_time_seconds": 300,
    "enable_immediate_patching": true,
    "enable_context_inference": true
  },
  "dependency_resolution": {
    "enabled": true,
    "confidence_threshold": 0.7
  },
  "example_repo": {
    "url": "https://github.com/aspose-imaging/Aspose.Imaging-for-.NET",
    "examples_path": "Examples",
    "test_data_path": "Examples/Data",
    "ref": "master"
  }
}
