{
  "family": "zip",
  "display_name": "Aspose.ZIP for .NET",
  "auto_commit": true,
  "commit_message_template": "fix(zip): apply {patch_count} patches\n\n{file_list}\n\nSnippets: {snippet_ids}",
  "content_roots": [
    "D:/onedrive/Documents/GitHub/aspose.net/content/blog.aspose.net/zip",
    "D:/onedrive/Documents/GitHub/aspose.net/content/kb.aspose.net/zip/en"
  ],
  "content_pattern": {
    "blog": "**/index.md",
    "kb": "**/*.md"
  },
  "file_exclude_patterns": [
    "index\\.[a-z]{2}\\.md$",
    "index\\.[a-z]{2}-[a-z]{2}\\.md$",
    "[/\\\\](ar|bg|ca|cs|da|de|el|es|fa|fi|fr|he|hi|hr|hu|id|it|ja|ko|lt|lv|ms|nl|no|pl|pt|ro|ru|sk|sr|sv|th|tr|uk|vi|zh)[/\\\\]"
  ],
  "nuget_config": {
    "primary_package": {
      "name": "Aspose.Zip",
      "version_strategy": "latest_stable"
    },
    "additional_packages": [],
    "target_frameworks": ["net8.0"]
  },
  "code_defaults": {
    "default_usings": [
      "System",
      "System.IO",
      "System.Text",
      "Aspose.Zip",
      "Aspose.Zip.Saving",
      "Aspose.Zip.SevenZip",
      "Aspose.Zip.Rar"
    ]
  },
  "patterns": [],
  "non_existent_apis": [
    "SaveAsync",
    "CreateEntryAsync",
    "ExtractAsync",
    "OpenAsync"
  ],
  "api_patterns": {
    "compression_basic": {
      "description": "Create archive with compression settings",
      "code": "var settings = new ArchiveEntrySettings(new DeflateCompressionSettings());\nusing (var archive = new Archive(settings)) {\n    archive.CreateEntry(\"file.txt\", \"source.txt\");\n    archive.Save(\"output.zip\");\n}"
    },
    "extraction_basic": {
      "description": "Extract archive entries",
      "code": "using (var archive = new Archive(\"input.zip\")) {\n    foreach (var entry in archive.Entries) {\n        entry.Extract(entry.Name);\n    }\n}"
    }
  },
  "runtime_validation": {
    "enabled": true,
    "mode": "lenient",
    "timeout_seconds": 30,
    "required_files": ["sample.zip", "archive.zip", "outer.zip", "flatten.zip", "different_password.zip", "encrypted_password.zip", "archive.7z", "archive.gz", "sample.gz", "plrabn12.rar", "encrypted.rar", "alice29.txt", "sample.txt", "asyoulik.txt", "plrabn12.txt", "lcet10.txt"],
    "required_dirs": ["sample_dir"],
    "file_aliases": {
      "sample.zip": ["input.zip", "example.zip", "source.zip", "ZipFileToBeExtracted.zip", "parent.zip"],
      "archive.zip": ["test.zip", "data.zip"],
      "plrabn12.rar": ["archive.rar", "input.rar", "example.rar", "sample.rar", "data.rar"],
      "encrypted.rar": ["encrypted_archive.rar", "password_protected.rar", "protected.rar"],
      "archive.7z": ["input.7z", "protected.7z", "example.7z"],
      "encrypted_password.zip": ["encrypted.zip", "protected.zip"],
      "different_password.zip": ["password_protected.zip", "secure.zip"],
      "sample_dir": ["input", "data", "sourceDir", "files", "input_folder"],
      "alice29.txt": ["file.txt", "source.txt", "input.txt", "file1.txt", "file2.txt"],
      "sample.txt": ["data.txt", "readme.txt"],
      "asyoulik.txt": ["text1.txt"],
      "plrabn12.txt": ["text2.txt"]
    },
    "expected_outputs": ["*.zip", "output/*.zip", "*.7z"],
    "env": {}
  },
  "test_data": {
    "local_path": "test-data/zip",
    "download_if_missing": false,
    "inventory_path": "artifacts/backfill/zip/test-data-inventory.json"
  },
  "example_repo": {
    "url": "https://github.com/aspose-zip/Aspose.ZIP-for-.NET",
    "examples_path": "Examples/CSharp",
    "test_data_path": "Examples/Data",
    "ref": "master"
  },
  "gist": {
    "enabled": true,
    "pat_env_var": "GITHUB_GIST_TOKEN"
  },
  "discovery_patterns": {
    "fence_patterns": [
      "^```(\\w+|c#)\\s*\\n(.*?)^```"
    ],
    "validatable_languages": ["cs", "csharp", "c#", "C#"],
    "normalize_to_canonical": true,
    "regex_timeout_seconds": 5.0,
    "context_extraction": {
      "enabled": true,
      "max_paragraphs": 3,
      "include_file_header": true
    },
    "gist_extraction": {
      "enabled": true,
      "allowed_owners": ["aspose-com-gists", "aspose-zip"],
      "blocked_owners": []
    }
  },
  "context_enforcement": {
    "enabled": true
  },
  "fixture_passwords": {
    "default": "p@s$",
    "encrypted_password.zip": "p@s$",
    "encrypted.rar": "p@s$",
    "different_password.zip": {"0": "first_pass", "1": "second_pass"}
  },
  "api_catalog": {
    "enabled": true,
    "storage_type": "json",
    "path": "config/families/zip_api_catalog.json",
    "lazy_loading": false
  },
  "fixture_resolver": {
    "enabled": true,
    "max_generations_per_run": 50,
    "registry_path": "artifacts/backfill/zip/fixture-registry.json"
  },
  "learned_patterns": {
    "enabled": true,
    "min_confidence": 0.6,
    "max_patterns_per_error": 3,
    "require_approval": true,
    "feedback_tracking": true,
    "retire_threshold": 0.3,
    "retire_min_applications": 10
  }
}
