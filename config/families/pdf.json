{
  "family": "pdf",
  "display_name": "Aspose.PDF for .NET",
  "auto_commit": true,
  "commit_message_template": "fix(pdf): apply {patch_count} patches\n\n{file_list}\n\nSnippets: {snippet_ids}",
  "content_roots": [
    "${ASPOSE_CONTENT_ROOT}/blog.aspose.net/pdf",
    "${ASPOSE_CONTENT_ROOT}/docs.aspose.net/pdf/en",
    "${ASPOSE_CONTENT_ROOT}/kb.aspose.net/pdf/en"
  ],
  "content_pattern": {
    "blog": "**/index.md",
    "docs": "**/*.md",
    "kb": "**/*.md"
  },
  "nuget_config": {
    "primary_package": {
      "name": "Aspose.PDF",
      "version_strategy": "latest_stable",
      "version": "26.8.0"
    },
    "additional_packages": [
      {
        "name": "System.Net.Http",
        "version": "4.3.4"
      },
      {
        "name": "Newtonsoft.Json",
        "version": "13.0.3"
      },
      {
        "name": "System.Data.SqlClient",
        "version": "4.8.6"
      },
      {
        "name": "Azure.Storage.Blobs",
        "version": "12.19.1"
      }
    ],
    "target_frameworks": [
      "net8.0"
    ]
  },
  "code_defaults": {
    "default_usings": [
      "System",
      "System.IO",
      "Aspose.Pdf",
      "Aspose.Pdf.Text",
      "Aspose.Pdf.Forms",
      "Aspose.Pdf.Annotations",
      "Aspose.Pdf.Operators"
    ]
  },
  "namespace_policy": {
    "mode": "whitelist",
    "allowed_namespaces": [
      "Aspose.Pdf",
      "Aspose.Pdf.*",
      "System",
      "System.*",
      "System.Net.Http",
      "System.Net.Http.*",
      "System.Data",
      "System.Data.*",
      "Newtonsoft.Json",
      "Newtonsoft.Json.*"
    ],
    "blacklist": []
  },
  "cs_discovery": {
    "enabled": true,
    "roots": [],
    "exclude_patterns": [
      "RunExamples\\.cs$",
      "AssemblyInfo\\.cs$",
      "\\.Designer\\.cs$",
      "\\bobj\\b",
      "\\bbin\\b"
    ],
    "extraction_strategy": "exstart_exend",
    "data_dir_replacements": {
      "RunExamples\\.GetDataDir_\\w+\\(\\)": "./"
    },
    "entry_point_pattern": "Run"
  },
  "example_repo": {
    "url": "https://github.com/aspose-pdf/Aspose.PDF-for-.NET",
    "examples_path": "Examples/CSharp",
    "test_data_path": "Examples/Data",
    "ref": "master"
  },
  "test_data": {
    "local_path": "artifacts/backfill/pdf/test-data",
    "download_if_missing": true
  },
  "runtime_validation": {
    "enabled": true,
    "mode": "lenient",
    "timeout_seconds": 30,
    "required_files": [],
    "required_dirs": [],
    "file_aliases": {}
  },
  "gist": {
    "enabled": true,
    "pat_env_var": "GITHUB_GIST_TOKEN"
  },
  "fixture_resolver": {
    "enabled": true,
    "max_generations_per_run": 100,
    "registry_path": "artifacts/backfill/pdf/fixture-registry.json"
  },
  "api_catalog": {
    "enabled": true,
    "storage_type": "json",
    "path": "config/families/pdf_api_catalog.json"
  },
  "learned_patterns": {
    "enabled": true,
    "min_confidence": 0.6,
    "max_patterns_per_error": 3,
    "require_approval": false,
    "feedback_tracking": true,
    "retire_threshold": 0.3,
    "retire_min_applications": 10
  },
  "api_patterns": {},
  "persistent_fix": {
    "enabled": true,
    "max_iterations": 10,
    "iterations_per_model": 3,
    "max_time_seconds": 300,
    "enable_immediate_patching": true,
    "enable_context_inference": true
  },
  "discovery_patterns": {
    "gist_extraction": {
      "enabled": true,
      "allowed_owners": [
        "aspose-net",
        "aspose-com-gists",
        "aspose-cloud",
        "aspose-pdf-gists"
      ],
      "blocked_owners": []
    }
  },
  "dependency_resolution": {
    "enabled": true,
    "confidence_threshold": 0.7
  }
}
