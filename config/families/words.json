{
  "family": "words",
  "display_name": "Aspose.Words for .NET",
  "auto_commit": true,
  "commit_message_template": "fix(words): apply {patch_count} patches\n\n{file_list}\n\nSnippets: {snippet_ids}",
  "content_roots": [
    "${ASPOSE_CONTENT_ROOT}/blog.aspose.net/words",
    "${ASPOSE_CONTENT_ROOT}/docs.aspose.net/words/en",
    "${ASPOSE_CONTENT_ROOT}/kb.aspose.net/words/en"
  ],
  "content_pattern": {
    "blog": "**/index.md",
    "docs": "**/*.md",
    "kb": "**/*.md"
  },
  "file_exclude_patterns": [
    "index\\.[a-z]{2}\\.md$",
    "index\\.[a-z]{2}-[a-z]{2}\\.md$",
    "[/\\\\](ar|bg|ca|cs|da|de|el|es|fa|fi|fr|he|hi|hr|hu|id|it|ja|ko|lt|lv|ms|nl|no|pl|pt|ro|ru|sk|sr|sv|th|tr|uk|vi|zh)[/\\\\]"
  ],
  "nuget_config": {
    "primary_package": {
      "name": "Aspose.Words",
      "version_strategy": "latest_stable"
    },
    "additional_packages": [],
    "target_frameworks": [
      "net8.0"
    ]
  },
  "code_defaults": {
    "default_usings": [
      "System",
      "System.IO",
      "System.Text",
      "Aspose.Words",
      "Aspose.Words.Saving",
      "Aspose.Words.Tables",
      "Aspose.Words.Fields",
      "Aspose.Words.Drawing",
      "Aspose.Words.Loading",
      "Aspose.Words.Replacing"
    ]
  },
  "namespace_policy": {
    "mode": "whitelist",
    "allowed_namespaces": [
      "Aspose.Words",
      "Aspose.Words.*",
      "System",
      "System.IO",
      "System.Text",
      "System.Drawing",
      "System.Drawing.*",
      "System.Collections.Generic",
      "System.Linq",
      "System.Data"
    ],
    "blacklist": []
  },
  "api_patterns": {},
  "runtime_validation": {
    "enabled": true,
    "mode": "lenient",
    "timeout_seconds": 30,
    "required_files": [
      "Document.docx",
      "Document.doc",
      "Document.html",
      "Document.odt",
      "Blank.docx",
      "Bookmarks.docx",
      "Comments.docx",
      "Tables.docx",
      "English text.txt"
    ],
    "required_dirs": [
      "Images",
      "Database"
    ],
    "file_aliases": {
      "Document.docx": [
        "input.docx",
        "source.docx",
        "sample.docx",
        "example.docx",
        "test.docx"
      ],
      "Document.doc": [
        "input.doc",
        "source.doc",
        "sample.doc",
        "example.doc"
      ],
      "Blank.docx": [
        "empty.docx",
        "new.docx",
        "template.docx",
        "output.docx"
      ],
      "Images": [
        "images",
        "Pictures",
        "pictures",
        "Resources"
      ]
    },
    "expected_outputs": [
      "*.docx",
      "*.pdf",
      "*.html",
      "output/*.docx"
    ],
    "env": {}
  },
  "test_data": {
    "local_path": "artifacts/backfill/words/test-data",
    "download_if_missing": false,
    "inventory_path": "artifacts/backfill/words/test-data-inventory.json"
  },
  "example_repo": {
    "url": "https://github.com/aspose-words/Aspose.Words-for-.NET",
    "examples_path": "Examples/ApiExamples/ApiExamples",
    "samples_path": "Examples/DocsExamples/DocsExamples",
    "test_data_path": "Examples/Data",
    "ref": "master"
  },
  "gist": {
    "enabled": false,
    "pat_env_var": "GITHUB_PAT"
  },
  "discovery_patterns": {
    "fence_patterns": [
      "^```(\\w+|c#)\\s*\\n(.*?)^```"
    ],
    "validatable_languages": [
      "cs",
      "csharp",
      "c#",
      "C#"
    ],
    "normalize_to_canonical": true,
    "regex_timeout_seconds": 5.0,
    "context_extraction": {
      "enabled": true,
      "max_paragraphs": 3,
      "include_file_header": true
    },
    "gist_extraction": {
      "enabled": false,
      "allowed_owners": [
        "aspose-com-gists",
        "aspose-words"
      ],
      "blocked_owners": []
    },
    "require_code_indicators": [],
    "min_line_count": 1,
    "max_line_count": 500
  },
  "context_enforcement": {
    "enabled": true
  },
  "fixture_passwords": {
    "default": "p@s$",
    "Encrypted.docx": "p@s$",
    "Encrypted.odt": "p@s$",
    "Encrypted.ott": "p@s$"
  },
  "api_catalog": {
    "enabled": true,
    "storage_type": "json",
    "path": "config/families/words_api_catalog.json",
    "lazy_loading": true,
    "assembly_verified": true,
    "assembly_version": "26.1.0"
  },
  "fixture_resolver": {
    "enabled": true,
    "max_generations_per_run": 50,
    "registry_path": "artifacts/backfill/words/fixture-registry.json"
  },
  "learned_patterns": {
    "enabled": true,
    "min_confidence": 0.6,
    "max_patterns_per_error": 3,
    "require_approval": false,
    "feedback_tracking": true,
    "retire_threshold": 0.3,
    "retire_min_applications": 10
  },
  "persistent_fix": {
    "enabled": true,
    "max_iterations": 10,
    "iterations_per_model": 3,
    "max_time_seconds": 300,
    "enable_immediate_patching": true,
    "enable_context_inference": true
  },
  "dependency_resolution": {
    "enabled": true,
    "confidence_threshold": 0.7
  }
}
