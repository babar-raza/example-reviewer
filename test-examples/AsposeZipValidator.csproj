<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Latest Aspose packages -->
    <PackageReference Include="Aspose.OCR" Version="26.1.0" />
    <PackageReference Include="Aspose.Zip" Version="*" />
    <PackageReference Include="Aspose.BarCode" Version="*" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- TASK-R2: System.Drawing.Common for .NET Framework API support -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude test subdirectory, example code directories, and ad-hoc test files to avoid conflicts -->
    <Compile Remove="test\**" />
    <Compile Remove="zip\**" />
    <Compile Remove="test_*.cs" />
    <Compile Remove="Program_GenFixtures.cs" />
    <EmbeddedResource Remove="test\**" />
    <EmbeddedResource Remove="zip\**" />
    <None Remove="test\**" />
    <None Remove="zip\**" />
  </ItemGroup>

</Project>
