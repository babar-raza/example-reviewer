# Example Reviewer API (lightweight validation image)
#
# This image excludes the .NET SDK and targets lightweight validation-oriented
# endpoints such as `validate_code_snippet`, `status`, and `scan`.

FROM python:3.12-slim-bookworm

WORKDIR /app

COPY requirements-light.txt ./
RUN pip install --no-cache-dir -r requirements-light.txt

COPY src/ ./src/
COPY config/ ./config/

RUN mkdir -p /app/data /app/workspace

RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 18800

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:18800/healthz')"

CMD ["python", "-m", "uvicorn", "src.http_server:app", "--host", "0.0.0.0", "--port", "18800"]
