# Example Reviewer - Environment Variables
# Copy this to .env and fill in your values

# GitHub Token for reading public gists (optional, increases rate limit)
# No scopes required - just increases rate limit from 60 to 5000/hour
GITHUB_TOKEN=ghp_your_read_token_here

# Gist Publishing Configuration (required for upload modes)
# Owner: Your GitHub username or organization
GIST_PUBLISH_OWNER=your-github-username

# Token: GitHub Personal Access Token with 'gist' scope
GIST_PUBLISH_TOKEN=ghp_your_publish_token_here

# Public: Set to 'false' to create private gists
GIST_PUBLISH_PUBLIC=true

## Update — 2026-01-12 20:07 PKT
# Optional: Local Telemetry API endpoint (see docs/local-telemetry.md)
TELEMETRY_API_URL=http://localhost:8765

# Optional: HTTP request timeout in milliseconds (default: 2000)
TELEMETRY_API_TIMEOUT_MS=2000

# Optional: Enable API authentication (default: false)
TELEMETRY_API_AUTH_ENABLED=false
TELEMETRY_API_AUTH_TOKEN=your-secret-token-here

## Update — 2026-01-12 20:39 PKT
# Optional: Enable auto-commit by default for all families (default: false)
AUTO_COMMIT_ENABLED=false

## Update — 2026-03-10
# Content Discovery Paths
# Set this to the root directory of your Aspose.NET content checkout.
# Each family config uses ${ASPOSE_CONTENT_ROOT} as the base path for content_roots.
# The config loader automatically expands ${VAR} tokens from this .env file.
# Example (Windows): D:/onedrive/Documents/GitHub/aspose.net/content
# Example (Linux/Mac): /home/yourname/repos/aspose.net/content
ASPOSE_CONTENT_ROOT=/path/to/your/aspose.net/content

## Update — 2026-08-29 (TC-EPIC1-06)
# HTTP API server (src/http_server.py, docker-compose.yml) auth.
# REQUIRED for any deployment reachable from outside localhost: generate a
# random secret (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
# and set it here. Without this set, the server refuses every request except
# /healthz (fails closed) unless EXAMPLE_REVIEWER_DEV_MODE=true below.
EXAMPLE_REVIEWER_API_KEY=

# Local-development-only escape hatch: serves all routes with NO authentication
# when EXAMPLE_REVIEWER_API_KEY is unset. Never set this to true in a deployment
# reachable from any network other than your own machine.
EXAMPLE_REVIEWER_DEV_MODE=false

# Optional: comma-separated CORS origin allowlist (default "*", which disables
# credentialed CORS automatically). Optional: request timeout/body-size/rate-limit
# tuning -- see src/http_server.py's _parse_bounded_int_env() defaults.
EXAMPLE_REVIEWER_CORS_ORIGINS=*
