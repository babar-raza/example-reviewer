# Example Reviewer - Environment Variables
# Copy this to .env and fill in your values

# GitHub Token for reading public gists (optional, increases rate limit)
# No scopes required - just increases rate limit from 60 to 5000/hour
GITHUB_TOKEN=ghp_your_read_token_here

# Gist Publishing Configuration (required for upload modes)
# Owner: Your GitHub username or organization
GIST_PUBLISH_OWNER=your-github-username

# Token: GitHub Personal Access Token with 'gist' scope
GIST_PUBLISH_TOKEN=ghp_your_publish_token_here

# Public: Set to 'false' to create private gists
GIST_PUBLISH_PUBLIC=true
